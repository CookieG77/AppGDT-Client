# Adresse d'écoute du client web
PORT=3000
ADDRESS=localhost

# URL de base de l'API (dépôt AppGDT-Server)
API_BASE_URL=http://localhost:8080
# Durée maximale d'un appel à l'API
API_TIMEOUT=5s
# HTTPS vers l'API (optionnel) : utiliser une URL https:// ci-dessus.
# Si le certificat de l'API n'est pas reconnu par le système (mkcert, auto-signé),
# indiquer ici l'autorité à approuver, au format PEM.
API_CA_FILE=

# HTTPS entre le navigateur et le client (optionnel).
# Renseigner les deux chemins pour activer HTTPS, laisser vide pour rester en HTTP.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Force les navigateurs à toujours utiliser HTTPS (à activer en production uniquement)
TLS_HSTS=false
